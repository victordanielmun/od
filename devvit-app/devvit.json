{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "odyssey-rpg",
  "permissions": {
    "redis": true,
    "realtime": true,
    "http": {
      "enable": true,
      "domains": ["api.openai.com"]
    }
  },
  "post": {
    "dir": "src/client",
    "entrypoints": {
      "default": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "src/server",
    "entry": "index.ts"
  },
  "settings": {
    "app": {
      "openai-api-key": {
        "type": "string",
        "label": "OpenAI API key",
        "isSecret": true,
        "scope": "app"
      },
      "openai-model": {
        "type": "string",
        "label": "OpenAI model (default gpt-4o-mini)",
        "scope": "app"
      }
    }
  }
}
