{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "odyssey-rpg-test",
  "permissions": {
    "redis": true,
    "realtime": true,
    "http": {
      "enable": true,
      "domains": [
        "api.openai.com"
      ]
    }
  },
  "post": {
    "dir": "src/client",
    "entrypoints": {
      "default": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Start Odyssey RPG",
        "location": "subreddit",
        "endpoint": "/internal/create-post",
        "forUserType": "user"
      }
    ]
  },
  "dev": {
    "subreddit": "odyssey_rpg_test_dev"
  }
}