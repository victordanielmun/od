# =============================================================
# .env de PRODUCCIÓN para EC2 — voice backend (Python FastAPI)
# Destino en el servidor: /home/ec2-user/od/voice/backend/.env
# Usa el MISMO DB_PASSWORD que gather-rpg-backend/.env.ec2
# =============================================================

# Misma Postgres que el backend Go (docker-compose, puerto 5433)
DATABASE_URL=postgresql://postgres:09f31543ba6097f74bff9bc10c7a01b4@127.0.0.1:5433/gather_rpg

DEBUG=False

# Con Nginx como proxy (/voice) el origen es el propio dominio/IP pública.
# Reemplaza la IP si la instancia nueva tiene otra.
CORS_ORIGINS=["http://localhost:5173","http://18.221.199.221"]

OPENAI_API_KEY=<PENDIENTE: misma key que el backend Go>

# Audio
UPLOAD_DIR=uploads
MAX_AUDIO_SIZE_MB=10

# TTS
TTS_CACHE_DIR=tts_cache
