# =============================================================
# .env de PRODUCCIÓN para EC2 — gather-rpg-backend (Go)
# Destino en el servidor: /home/ec2-user/od/gather-rpg-backend/.env
# Reconstruido desde internal/config/config.go (todas las variables que lee).
# Los valores marcados <PENDIENTE> hay que llenarlos antes de arrancar.
# =============================================================

# Server
SERVER_PORT=3000
ENV=production

# Database (PostgreSQL del docker-compose de este repo: host 5433 -> contenedor 5432)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=<CAMBIAR_POR_TU_PASSWORD_SEGURO>
DB_NAME=gather_rpg

# Redis (docker-compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<CAMBIAR_POR_TU_PASSWORD_REDIS>

# JWT
JWT_SECRET=<GENERA_UN_SECRET_SEGURO_AQUI>
JWT_EXPIRATION=24h

# AI Provider (choices: deepseek, openai, mistral)
AI_PROVIDER=openai
OPENAI_API_KEY=<TU_OPENAI_API_KEY>
OPENAI_MODEL=gpt-5.4-nano-2026-03-17

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Evolution API (WhatsApp) — corre en el mismo docker-compose, puerto 8080
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=<TU_EVOLUTION_API_KEY>

# Piper TTS (rutas absolutas en EC2, binario Linux SIN .exe)
PIPER_EXE_PATH=/home/ec2-user/od/gather-rpg-backend/bin/piper/piper
PIPER_MODELS_DIR=/home/ec2-user/od/gather-rpg-backend/models
PIPER_CACHE_DIR=/home/ec2-user/od/gather-rpg-backend/tts_cache
TTS_CACHE_TTL_DAYS=7
TTS_CACHE_MAX_MB=500

# Idiomas cuyas traducciones de misiones/tareas se pre-calientan al arrancar
PRECACHE_LANGS=es

# Wompi (membresías) — claves del panel: comercios.wompi.co > Desarrolladores
WOMPI_BASE_URL=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=<TU_WOMPI_PUBLIC_KEY>
WOMPI_PRIVATE_KEY=<TU_WOMPI_PRIVATE_KEY>
WOMPI_EVENTS_SECRET=<TU_WOMPI_EVENTS_SECRET>
WOMPI_INTEGRITY_SECRET=<TU_WOMPI_INTEGRITY_SECRET>
MEMBERSHIP_AMOUNT_CENTS=2000000
MEMBERSHIP_CURRENCY=COP
MEMBERSHIP_PERIOD_DAYS=30

# Primer arranque: true para crear TODO el esquema (enums + tablas).
# Después del primer arranque exitoso, volver a false (arranque rápido).
AUTO_MIGRATE=false
