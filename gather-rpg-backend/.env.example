# Server
SERVER_PORT=3000
ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gather_rpg

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRATION=24h

# --- Performance / startup ---
# Skip GORM AutoMigrate on startup (slow against a remote DB). Set true after
# pulling model/schema changes to apply them, then back to false.
AUTO_MIGRATE=false
# Player languages whose mission/task translations are pre-warmed at startup and
# on mission edit, so the first dialogue open is fast. Comma-separated ISO codes.
PRECACHE_LANGS=es
