# Server
SERVER_PORT=3000
ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gather_rpg

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRATION=24h

# AI Provider (choices: deepseek, openai, mistral)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution_secret_key

# Piper TTS
PIPER_EXE_PATH=./bin/piper/piper.exe
PIPER_MODELS_DIR=./models
PIPER_CACHE_DIR=./tts_cache

# Wompi (membresías) — llaves en comercios.wompi.co > Desarrolladores
# Sandbox: https://sandbox.wompi.co/v1 con llaves pub_test_/prv_test_
WOMPI_BASE_URL=https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
MEMBERSHIP_AMOUNT_CENTS=2000000
MEMBERSHIP_CURRENCY=COP
MEMBERSHIP_PERIOD_DAYS=30

# --- Performance / startup ---
# Skip GORM AutoMigrate on startup (slow against a remote DB). Set true after
# pulling model/schema changes to apply them, then back to false.
AUTO_MIGRATE=false
# Player languages whose mission/task translations are pre-warmed at startup and
# on mission edit, so the first dialogue open is fast. Comma-separated ISO codes.
PRECACHE_LANGS=es

# --- TTS cache janitor (Piper .wav files) ---
# Los audios expiran tras N días sin usarse (cada cache-hit renueva la fecha) y
# el caché completo se limita a un tamaño máximo, borrando los más viejos.
# 0 desactiva ese criterio. Corre al arrancar y cada 6 horas.
TTS_CACHE_TTL_DAYS=7
TTS_CACHE_MAX_MB=500
